# Copy to .env (never commit .env). Every value here is a safe default;
# SPHEREx data at IRSA is public, so no API key is needed.

# IRSA SIA2 collections for the API 0.1 live source.
SPHEREX_COLLECTION=spherex_dr1
SPHEREX_COLLECTION_FALLBACK=spherex_qr3

# Local folders (both are gitignored)
DATA_DIR=data
CACHE_DIR=.cache

# Backend (FastAPI)
API_HOST=127.0.0.1
API_PORT=8000
# Use "*" for public GET requests or comma-separated frontend origins.
CORS_ALLOW_ORIGINS=*
# Historical app.legacy_main settings for the Day 6 exercise.
FRAMES_MODE=live
# live queries IRSA; fixture reprocesses the local FITS pack.
PIPELINE_SOURCE=live

# Frontend (Vite only exposes variables that start with VITE_)
VITE_API_BASE_URL=http://127.0.0.1:8000
# frontend/: MSW mocks from api_samples/ are on in `npm run dev` unless this is false.
VITE_USE_MOCK=false

# Issue #14 API 0.1 entry point.
# live    = query IRSA on demand (team default)
# real    = only validated local DR1 cutouts in data/spherex/ (no demo fallback)
# fixture = offline api_samples/ and fixture FITS pack
DATA_MODE=live
