# Copy to .env (never commit .env). Every value here is a safe default;
# SPHEREx data at IRSA is public, so no API key is needed.

# IRSA SIA2 collections for the API 0.1 live source.
SPHEREX_COLLECTION=spherex_dr1
SPHEREX_COLLECTION_FALLBACK=spherex_qr3

# Local folders (both are gitignored)
DATA_DIR=data
CACHE_DIR=.cache

# Backend (FastAPI)
API_HOST=127.0.0.1
API_PORT=8000
# Use "*" for public GET requests or comma-separated frontend origins.
CORS_ALLOW_ORIGINS=*
# Historical app.legacy_main settings for the Day 6 exercise.
FRAMES_MODE=live
# live queries IRSA; fixture reprocesses the local FITS pack.
PIPELINE_SOURCE=live

# Frontend (Vite only exposes variables that start with VITE_)
VITE_API_BASE_URL=http://127.0.0.1:8000
# frontend/: MSW mocks from api_samples/ are on in `npm run dev` unless this is false.
VITE_USE_MOCK=false

# API 0.1 data source.
# live     = query NASA/IPAC IRSA on demand
# harvest  = read Khôi's local FITS from data/harvest
# database = read sky_archive metadata/products from Supabase and local FITS paths
# real     = validated local DR1 cutouts
# fixture  = offline demo samples and fixture FITS pack
DATA_MODE=database
API_MODE=real
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable-key>
SUPABASE_SCHEMA=sky_archive

# To run with the team's Supabase archive, change DATA_MODE to database and set
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SCHEMA above. Never commit .env.
# The publishable key is safe for a client protected by RLS. Do not use sb_secret_ here.
# Used by DATA_MODE=real: dr1 (default) or qr3 for the separate QR3 repair samples.
# Không tự động trộn release trong dữ liệu thật.
DATA_RELEASE=dr1
# Used by DATA_MODE=real: pair (default) serves only the screened DR1 pair from
# data/processed/ when one exists for the target and detector; all serves every validated cutout.
REAL_SELECTION=pair

# Supabase PostgreSQL (astronomy archive) for scripts/import_sky_archive.py. Copy the values from
# Dashboard > Connect > Session pooler and use your database password.
# PGHOST=aws-0-<region>.pooler.supabase.com
# PGPORT=5432
# PGDATABASE=postgres
# PGUSER=postgres.<project-ref>
# PGPASSWORD='your-database-password'
# PGSSLMODE=require
# PSQL_PATH=D:/DevTools/PostgreSQL/18/bin/psql.exe
# Server-side only, for scripts/sync_supabase_dr1.py uploading demo images to the public bucket
# spherex-dr1-demo. Secret key: keep it in .env, never in frontend/VITE_* or git.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Community forum (separate Supabase project, NOT the astronomy database) ---
# Postgres URL of the forum project (Dashboard > Connect > Session pooler).
# Backend only; never put it in a VITE_* variable.
# FORUM_DATABASE_URL=postgresql://postgres.<forum-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Forum project URL: JWT issuer <url>/auth/v1 and JWKS for asymmetric signing keys.
# FORUM_SUPABASE_URL=https://<forum-project-ref>.supabase.co
# Only for projects still on the legacy HS256 JWT secret.
# FORUM_SUPABASE_JWT_SECRET=
# HMAC key for pagination cursors; any long random string.
# FORUM_CURSOR_SECRET=
# Frontend auth (public anon/publishable key only, never the service_role key).
# VITE_SUPABASE_URL=https://<forum-project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=
# Switch the frontend forum from demo data to this backend.
# VITE_FORUM_API=http
