# Copy to .env (never commit .env). Every value here is a safe default;
# SPHEREx data at IRSA is public, so no API key is needed.

# IRSA SIA2 collection for the local DR1 dataset.
SPHEREX_COLLECTION=spherex_dr1
# Không tự động trộn release trong dữ liệu thật.

# Local folders (both are gitignored)
DATA_DIR=data
CACHE_DIR=.cache

# Backend (FastAPI)
API_HOST=127.0.0.1
API_PORT=8000
# Use "*" for public GET requests or comma-separated frontend origins.
CORS_ALLOW_ORIGINS=*
# Historical app.legacy_main settings for the Day 6 exercise.
FRAMES_MODE=mock
# live queries IRSA; fixture reprocesses the local FITS pack.
PIPELINE_SOURCE=live

# Frontend (Vite only exposes variables that start with VITE_)
VITE_API_BASE_URL=http://127.0.0.1:8000
# frontend/: set false to connect to the real local backend.
VITE_USE_MOCK=false

# API 0.1: local DR1 dataset
DATA_MODE=real
# Optional: qr3 selects the separately downloaded QR3 repair samples.
DATA_RELEASE=dr1
