# Public build-time settings (never put secrets in VITE_* variables).
# Origin of the SPHEREx Explorer API (FastAPI), without a trailing slash.
VITE_API_BASE_URL=
# "true" uses the in-browser Illustrative demo data. Mock mode is forced when VITE_API_BASE_URL is empty.
VITE_USE_MOCK=true

# Forum and login on the real backend: "http" uses Supabase Auth + /api/forum (forum-v1.1).
# Anything else (or a missing VITE_API_BASE_URL / VITE_SUPABASE_*) keeps the in-browser demo forum.
VITE_FORUM_API=mock
# The forum's own Supabase project (not the sky_archive one). Public anon/publishable key only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Star guide chatbot (Supabase Edge Function star-chat). Optional: defaults to the team function URL.
# The Gemini key is a Supabase secret (GEMINI_API_KEY), never a VITE_* variable.
VITE_STAR_CHAT_URL=
